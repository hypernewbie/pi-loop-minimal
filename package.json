{
  "name": "pi-loop-minimal",
  "version": "0.3.0",
  "description": "Minimal agent loops for pi: /loop goal <description> and /loop <N> <task>",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "loop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
